<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 조회(get)용 퍼미션만 선언. 제어(CONTROL_*)는 App Market 사전 승인 대상이라 넣지 않는다 -->
    <!-- 기어·주행거리 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 타이어 저압 기준값 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- getTirePressure 가 요구한다. App Market 허용 여부는 미확인 -->
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 문서엔 없지만 TextToSpeech.initialize() 가 이 퍼미션 없으면 SecurityException 을 던진다 (에뮬레이터 v2.1.0 실측) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 도착지 이름(onDestinationArrived) 조회 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- 앱을 열지 않아도 부팅 뒤 운행 감지를 시작한다 (에뮬레이터에서 동작 확인, pleos-probe) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 운행 종료 알림. 앱이 뒤에 있으면 화면을 직접 못 띄우므로 전체 화면 알림으로 연다 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:label="차량운행기록"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <!-- AAOS 는 이 표시가 없는 화면을 주행 중에 막는다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.TripEndActivity"
            android:exported="false"
            android:launchMode="singleTop">
            <!-- 입력 칸 없이 큰 버튼만 있어 주행 중 열려도 막히지 않게 한다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".ui.MonthlyActivity"
            android:exported="false">
            <!-- 읽기 위주 화면 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <!-- 입력 칸이 있는 화면은 주행 중 시스템이 막도록 distractionOptimized 를 두지 않는다 -->
        <activity
            android:name=".ui.UsersActivity"
            android:exported="false" />
        <activity
            android:name=".ui.VehicleInfoActivity"
            android:exported="false" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.TripService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
