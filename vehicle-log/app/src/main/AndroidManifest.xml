<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 조회(get)용 퍼미션만 선언. 제어(CONTROL_*)는 App Market 사전 승인 대상이라 넣지 않는다 -->
    <!-- 기어·주행거리 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 타이어 저압 기준값, 엔진오일·브레이크액·변속기오일 수준 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- 연료 잔량·전기차 배터리 잔량 (출발 점검, 운행기록표 비고) -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- getTirePressure 가 요구한다. App Market 허용 여부는 미확인 -->
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <!-- 차대번호·차량 등록번호 조회 (차량 정보 화면의 빈 칸을 채운다) -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 문서엔 없지만 TextToSpeech.initialize() 가 이 퍼미션 없으면 SecurityException 을 던진다 (에뮬레이터 v2.1.0 실측) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 도착지 이름(onDestinationArrived) 조회 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- 앱을 열지 않아도 부팅 뒤 운행 감지를 시작한다 (에뮬레이터에서 동작 확인, pleos-probe) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 운행 종료 알림. 앱이 뒤에 있으면 화면을 직접 못 띄우므로 전체 화면 알림으로 연다 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- "다른 앱 위에 표시" 허용이 있으면 앱이 뒤에 있어도 종료 화면을 바로 띄울 수 있다 (사용자가 설정에서 허용) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 운행기록표를 관리자 메일로 보낸다 (Gmail SMTP) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        모든 화면: Pleos 는 앱 창을 세로·가로 창 사이로 옮긴다. 창 크기가 바뀌어도 화면을 다시 만들지 않아 입력·선택이 남게 한다.
        밤/낮(uiMode)은 색을 다시 칠해야 해서 넣지 않는다
    -->
    <!-- 운행 DB 에 사용자 이름·위치가 있어 기기 백업(클라우드·adb backup)으로 빠져나가지 않게 막는다 -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="차량운행기록"
        android:supportsRtl="true"
        android:theme="@style/Theme.VehicleLog">

        <!-- 주행 중 제한(CarUxRestrictions)을 읽는다. 차량이 아닌 기기에서도 설치되게 필수로 두지 않는다 -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true">
            <!-- AAOS 는 이 표시가 없는 화면을 주행 중에 막는다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.TripEndActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTop">
            <!-- 주행 중 열려도 막히지 않게 한다. 도착지 입력 칸의 키보드는 주행 중 AAOS 가 막고, 큰 버튼(이전 도착지·분류)은 쓸 수 있다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <!--
            주행 중에 필요 없는 화면은 distractionOptimized 를 두지 않아 시스템이 막게 한다.
            월별 기록은 긴 목록(한국 주행 중 제한: 많은 글자 표시 금지), 보내기·관리 화면은 설정·입력 화면이다
        -->
        <activity
            android:name=".ui.MonthlyActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false" />
        <activity
            android:name=".ui.SendActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false" />
        <activity
            android:name=".ui.AdminActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false" />
        <activity
            android:name=".ui.PinActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false" />
        <activity
            android:name=".ui.UsersActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false" />
        <activity
            android:name=".ui.VehicleInfoActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.TripService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
