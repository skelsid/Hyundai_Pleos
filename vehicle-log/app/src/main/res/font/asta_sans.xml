    <font android:font="@font/asta_sans_variable" android:fontStyle="normal" android:fontWeight="600" android:fontVariationSettings="'wght' 600" />
    <font android:font="@font/asta_sans_variable" android:fontStyle="normal" android:fontWeight="700" android:fontVariationSettings="'wght' 700" />
